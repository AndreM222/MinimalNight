{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "Aws": "#FA9904",
    "BGRed": "#f34168",
    "DeepBlack": "#111111",
    "DeepGrey": "#303030",
    "DeepWhite": "#ffffff",
    "GitA": "#C792EA",
    "GitAB": "#db48aa",
    "GitB": "#f7397c",
    "GitChange": "#ff9900",
    "GitOK": "#17D7A0",
    "Node": "#88BD5B"
  },
  "console_title_template": "{{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "macos": "\uf179",
            "ubuntu": "\uebc6",
            "windows": "\udb80\udf72"
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0d6",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "foreground": "p:DeepWhite",
          "background": "p:DeepGrey",
          "type": "os",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "\ue0d6",
          "template": "\uf489 {{ .Name }} ",
          "foreground": "p:DeepWhite",
          "background": "p:DeepGrey",
          "type": "shell",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "\ue0b2",
          "template": "\udb80\udf5b CPU: {{ round .PhysicalPercentUsed .Precision }}% | ",
          "foreground": "p:DeepGrey",
          "background": "p:BGRed",
          "type": "sysinfo",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "trailing_diamond": "\ue0d6",
          "template": "MEM: {{ (div ((sub .PhysicalTotalMemory .PhysicalFreeMemory)|float64) 1000000000.0) }}/{{ (div .PhysicalTotalMemory 1000000000.0) }}GB \ue706 ",
          "foreground": "p:DeepGrey",
          "background": "p:BGRed",
          "type": "sysinfo",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "style": "roundrock",
            "threshold": 0
          },
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "\ue0b0",
          "template": " {{ .FormattedMs }} ",
          "foreground": "p:DeepWhite",
          "background": "p:DeepBlack",
          "type": "executiontime",
          "style": "diamond"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "fetch_version": false,
            "prefix": " \ue718 "
          },
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "\ue0d6",
          "template": " \ue718{{ .Full }} ",
          "foreground": "p:Node",
          "powerline_symbol": "\ue0b0",
          "background": "p:DeepBlack",
          "type": "node",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_version": false,
            "prefix": " \ue718 "
          },
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "\ue0d6",
          "template": " \udb83\ude0f{{.Profile}}{{if .Region}}@{{.Region}}{{end}} ",
          "foreground": "p:Aws",
          "powerline_symbol": "\ue0b0",
          "background": "p:DeepBlack",
          "type": "aws",
          "style": "diamond"
        },
        {
          "properties": {
            "branch_icon": "\ue725 ",
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_worktree_count": true
          },
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "\ue0b0 ",
          "template": " {{ .UpstreamIcon }} {{ .HEAD }}{{ .BranchStatus }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \uf692 {{ .StashCount }}{{ end }} ",
          "foreground": "p:DeepGrey",
          "background": "p:GitOK",
          "type": "git",
          "style": "diamond",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:GitChange{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:GitAB{{ end }}",
            "{{ if gt .Ahead 0 }}p:GitA{{ end }}",
            "{{ if gt .Behind 0 }}p:GitB{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "\u256d\u2500",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "time_format": "15:04"
          },
          "template": " \uf004 {{ .CurrentDate | date .Format }} |",
          "type": "time",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \uf292 ",
          "type": "root",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_icon": "\uf07b ",
            "folder_separator_icon": " \uf061 ",
            "home_icon": "\udb80\udedc "
          },
          "template": " {{ .Path }} ",
          "type": "path",
          "style": "plain"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": "\u2570\u2500 ",
          "type": "exit",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3
}
