{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "console_title_template": "{{ .Folder }}",
    "blocks": [
        {
            "type": "prompt",
            "alignment": "left",
            "segments": [
                {
                    "properties": {
                        "macos": "\uf179 ",
                        "ubuntu": "\uebc6 ",
                        "windows": "\udb80\udf72 "
                    },

                    "style": "diamond",
                    "leading_diamond": "\ue0b6",
                    "trailing_diamond": "\ue0d6",
                    "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
                    "foreground": "white",
                    "background": "235",
                    "type": "os"
                },

                {
                    "style": "diamond",
                    "leading_diamond": "\ue0b2",
                    "trailing_diamond": "\ue0d6",
                    "template": "\uf489 {{ .Name }} ",
                    "foreground": "white",
                    "background": "235",
                    "type": "shell"
                },

                {
                    "style": "diamond",
                    "leading_diamond": "\ue0b2",
                    "template": "\udb80\udf5b CPU: {{ round .PhysicalPercentUsed .Precision }}% | ",
                    "foreground": "235",
                    "background": "188",
                    "type": "sysinfo"
                },

                {
                    "style": "diamond",
                    "trailing_diamond": "\ue0d6",
                    "template": "MEM: {{ (div ((sub .PhysicalTotalMemory .PhysicalFreeMemory)|float64) 1000000000.0) }}/{{ (div .PhysicalTotalMemory 1000000000.0) }}GB \ue706 ",
                    "foreground": "235",
                    "background": "188",
                    "type": "sysinfo"
                },

                {
                    "properties": {
                        "style": "roundrock",
                        "threshold": 0
                    },

                    "style": "diamond",
                    "leading_diamond": "\ue0b2",
                    "trailing_diamond": "\ue0b0",
                    "template": " {{ .FormattedMs }} ",
                    "foreground": "white",
                    "background": "232",
                    "type": "executiontime"
                }
            ],
            "newline": true
        },
        {
            "type": "prompt",
            "alignment": "right",
            "segments": [
                {
                    "properties": {
                        "fetch_version": false,
                        "prefix": " \ue718 "
                    },

                    "style": "diamond",
                    "leading_diamond": "\ue0b2",
                    "trailing_diamond": "\ue0d6",
                    "template": " \ue718{{ .Full }} ",
                    "foreground": "lightGreen",
                    "powerline_symbol": "\ue0b0",
                    "background": "232",
                    "type": "node"
                },

                {
                    "properties": {
                        "fetch_version": false,
                        "prefix": " \ue718 "
                    },

                    "style": "diamond",
                    "leading_diamond": "\ue0b2",
                    "trailing_diamond": "\ue0d6",
                    "template": " \uf308 {{ .Context }} :: {{if .Namespace}}{{.Namespace}}{{else}}default{{end}}",
                    "foreground": "cyan",
                    "powerline_symbol": "\ue0b0",
                    "background": "232",
                    "type": "kubectl"
                },

                {
                    "properties": {
                        "fetch_version": false,
                        "prefix": " \ue718 "
                    },

                    "style": "diamond",
                    "leading_diamond": "\ue0b2",
                    "trailing_diamond": "\ue0d6",
                    "powerline_symbol": "\ue0b0",
                    "background": "232",
                    "foreground": "228",
                    "template": " \udb80\udf20 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}",
                    "type": "python"
                },

                {
                    "properties": {
                        "fetch_version": false,
                        "prefix": " \ue718 "
                    },

                    "style": "diamond",
                    "leading_diamond": "\ue0b2",
                    "trailing_diamond": "\ue0d6",
                    "template": " \udb83\ude0f{{.Profile}}{{if .Region}}@{{.Region}}{{end}} ",
                    "foreground": "yellow",
                    "powerline_symbol": "\ue0b0",
                    "background": "232",
                    "type": "aws"
                },

                {
                    "properties": {
                        "branch_icon": "\ue725 ",
                        "fetch_stash_count": true,
                        "fetch_status": true,
                        "fetch_upstream_icon": true,
                        "fetch_worktree_count": true
                    },

                    "style": "diamond",
                    "leading_diamond": "\ue0b2",
                    "trailing_diamond": "\ue0b0",
                    "template": " {{ .UpstreamIcon }} {{ .HEAD }}{{ .BranchStatus }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \udb80\udc77 {{ .StashCount }}{{ end }} ",
                    "foreground": "235",
                    "background": "green",
                    "type": "git",
                    "background_templates": [
                        "{{ if or (.Working.Changed) (.Staging.Changed) }}yellow{{ end }}",
                        "{{ if and (gt .Ahead 0) (gt .Behind 0) }}magenta{{ end }}",
                        "{{ if gt .Ahead 0 }}188{{ end }}",
                        "{{ if gt .Behind 0 }}red{{ end }}"
                    ]
                }
            ]
        },
        {
            "type": "prompt",
            "alignment": "left",
            "segments": [
                {
                    "style": "plain",
                    "template": "\u256d\u2500",
                    "foreground": "",
                    "background": "",
                    "type": "text"
                },

                {
                    "properties": {
                        "time_format": "15:04"
                    },
                    "style": "plain",
                    "template": " \uf004 {{ .CurrentDate | date .Format }} |",
                    "foreground": "",
                    "background": "",
                    "type": "time"
                },

                {
                    "style": "plain",
                    "template": " \uf292 ",
                    "foreground": "",
                    "background": "",
                    "type": "root"
                },

                {
                    "properties": {
                        "folder_icon": "\uf07b ",
                        "folder_separator_icon": " \uf061 ",
                        "home_icon": "\udb80\udedc "
                    },
                    "style": "plain",
                    "template": " {{ .Path }} ",
                    "foreground": "",
                    "background": "",
                    "type": "path"
                }
            ],
            "newline": true
        },

        {
            "type": "prompt",
            "alignment": "left",
            "segments": [
                {
                    "properties": {
                        "always_enabled": true
                    },
                    "style": "plain",
                    "template": "\u2570\u2500 ",
                    "foreground": "",
                    "background": "",
                    "type": "exit"
                }
            ],
            "newline": true
        }
    ],
    "version": 3
}
